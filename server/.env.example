# Copy this file to ".env" and fill in real values.
# ".env" is ignored by Git. Never commit real secrets.

NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/srms_dev?retryWrites=true&w=majority
# Optional. Uncomment ONLY if the database connection fails with "querySrv ECONNREFUSED".
# DNS_SERVERS=8.8.8.8,8.8.4.4
# Used ONLY by automated tests. The database name MUST end with _test.
MONGODB_URI_TEST=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/srms_test?retryWrites=true&w=majority